def ask_question(question):
    max_score=0
    mrc=""
    with open('data.txt', 'r') as file:
        for chunk in file:
            score=0
            for word in question.split():
                if word.lower() in chunk.lower():
                    score+=1
            if score>max_score:
                max_score=score
                mrc=chunk
    print(mrc)
